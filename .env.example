# Optional: Add your OpenAI API key for GPT-3.5 powered responses.
# Without this key, the app uses the built-in legal AI (no API needed).
OPENAI_API_KEY=sk-...

# Runtime mode and safety switches.
APP_ENV=development
USE_REAL_AI=true
ALLOW_MOCK_AI=true
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://localhost:8501

# Conversational LLM provider.
# Keep "rule" until your fine-tuned local model passes dataset/eval checks.
LLM_PROVIDER=rule
LOCAL_LLM_URL=http://localhost:11435/v1
LOCAL_LLM_MODEL=lex-ai-legal
LLM_TIMEOUT_SECONDS=30

# Upload/task limits.
MAX_UPLOAD_BYTES=52428800
REDIS_URL=redis://localhost:6379/0

# Optional OCR binary path. Required for scanned PDFs when tesseract is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
